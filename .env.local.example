# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se versiona (ver tech-stack.md > Límites duros).

# Cadena de conexión a MongoDB Atlas (o a una instancia local para desarrollo).
# Pendiente de configurar con la base real: por ahora solo se documenta la variable.
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/punisher_invoice

# Nombre de la base de datos dentro del cluster.
MONGODB_DB=punisher_invoice

# Secreto usado por Auth.js para firmar sesiones/JWT. Generar uno propio, por ejemplo con:
# openssl rand -base64 32
AUTH_SECRET=reemplaza-este-valor-con-un-secreto-generado
